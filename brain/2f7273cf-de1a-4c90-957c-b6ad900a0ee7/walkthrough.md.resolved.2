import Icon from './Icon';
import voiceService, { ParsedVoiceCommand } from '../services/voiceService';

interface VoiceInputProps {
  onResult: (text: string, command?: ParsedVoiceCommand) => void;
  onError?: (error: string) => void;
  placeholder?: string;
