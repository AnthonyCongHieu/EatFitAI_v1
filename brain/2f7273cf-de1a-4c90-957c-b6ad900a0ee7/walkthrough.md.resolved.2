        const text = await response.text();
        if ([500, 502, 503, 504].includes(response.status)) {
          return buildFallbackCookingInstructions(recipeName, ingredients);
        }

        const httpError = new Error(
          `Không thể tạo hướng dẫn nấu: ${text}`,
