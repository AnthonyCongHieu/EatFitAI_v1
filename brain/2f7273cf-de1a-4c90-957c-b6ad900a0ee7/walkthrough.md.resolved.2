        cookingTime: data.cookingTime,
        difficulty: data.difficulty,
      };
    } catch (error) {
      if (isAiOfflineError(error)) {
        return buildFallbackCookingInstructions(recipeName, ingredients);
      }
      throw error;
    }
  },
};
