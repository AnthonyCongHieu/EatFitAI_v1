# Cloud-first development target. Works from any machine with Expo + emulator.
EXPO_PUBLIC_API_BASE_URL=https://eatfitai-api.duckdns.org
APP_DEFAULT_TIME_ZONE=Asia/Ho_Chi_Minh
# Lightsail is the beta cloud backend. Override locally when you need a private dev backend.
EXPO_PUBLIC_MEDIA_PUBLIC_BASE_URL=https://pub-9081bce8ff6b4db5b4403ca7adae7b80.r2.dev

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_OFFLINE_ACCESS=false
EXPO_PUBLIC_GOOGLE_FORCE_CODE_FOR_REFRESH_TOKEN=false
